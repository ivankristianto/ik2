{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"border": {
			"radiusSizes": [
				{
					"name": "Small (4px)",
					"slug": "sm",
					"size": "0.25rem"
				},
				{
					"name": "Medium (6px)",
					"slug": "md",
					"size": "0.375rem"
				},
				{
					"name": "Large (8px)",
					"slug": "lg",
					"size": "0.5rem"
				},
				{
					"name": "Pill",
					"slug": "pill",
					"size": "999px"
				},
				{
					"name": "Round",
					"slug": "round",
					"size": "50%"
				}
			]
		},
		"color": {
			"custom": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#FCFCFA",
					"name": "Paper",
					"slug": "paper"
				},
				{
					"color": "#FFFFFF",
					"name": "Surface",
					"slug": "surface"
				},
				{
					"color": "#EFEFEB",
					"name": "Soft Paper",
					"slug": "soft-paper"
				},
				{
					"color": "#1C1D1B",
					"name": "Ink",
					"slug": "ink"
				},
				{
					"color": "#494A46",
					"name": "Graphite",
					"slug": "graphite"
				},
				{
					"color": "#5C5D58",
					"name": "Dust",
					"slug": "dust"
				},
				{
					"color": "#DCDCD5",
					"name": "Line",
					"slug": "line"
				},
				{
					"color": "#B6B6AE",
					"name": "Rule",
					"slug": "rule"
				},
				{
					"color": "#2F5D50",
					"name": "Bookcloth",
					"slug": "signal"
				},
				{
					"color": "#234539",
					"name": "Deep Bookcloth",
					"slug": "signal-deep"
				},
				{
					"color": "#E1EAE5",
					"name": "Bookcloth Wash",
					"slug": "signal-soft"
				},
				{
					"color": "#F1F1ED",
					"name": "Code Paper",
					"slug": "code-paper"
				},
				{
					"color": "#2F5D50",
					"name": "Build Green",
					"slug": "build-green"
				},
				{
					"color": "#8A5A14",
					"name": "Amber",
					"slug": "amber"
				},
				{
					"color": "#A33A2A",
					"name": "Red",
					"slug": "red"
				}
			],
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"duotone": [],
			"gradients": []
		},
		"custom": {
			"color": {
				"scrim": "color-mix(in srgb, var(--wp--preset--color--ink) 30%, transparent)",
				"syntax": {
					"comment": "var(--wp--preset--color--graphite)",
					"keyword": "var(--wp--preset--color--signal-deep)",
					"string": "#7A4E1C"
				}
			},
			"focus": {
				"width": "2px",
				"offset": "3px"
			},
			"fontSize": {
				"numeral": "clamp(7rem, 18vw, 14rem)"
			},
			"fontWeight": {
				"regular": "400",
				"medium": "500",
				"semibold": "600",
				"bold": "700",
				"heavy": "800"
			},
			"letterSpacing": {
				"tightest": "-0.04em",
				"tighter": "-0.03em",
				"tight": "-0.02em",
				"snug": "-0.01em",
				"normal": "0",
				"wide": "0.02em",
				"wider": "0.05em",
				"widest": "0.08em"
			},
			"lineHeight": {
				"compact": "0.9",
				"flat": "1",
				"tight": "1.1",
				"snug": "1.25",
				"normal": "1.4",
				"comfortable": "1.55",
				"relaxed": "1.7"
			},
			"transition": {
				"base": "200ms ease",
				"drawer": "280ms cubic-bezier(0.22, 1, 0.36, 1)"
			},
			"width": {
				"full": "1280px",
				"measure": "60ch"
			}
		},
		"layout": {
			"contentSize": "960px",
			"wideSize": "1200px"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Small (card hover)",
					"slug": "sm",
					"shadow": "0 1px 2px rgba(0, 0, 0, 0.04), 0 1px 1px rgba(0, 0, 0, 0.03)"
				},
				{
					"name": "Medium (palette, modal)",
					"slug": "md",
					"shadow": "0 6px 24px rgba(0, 0, 0, 0.08)"
				}
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "1 (4px)",
					"size": "0.25rem",
					"slug": "1"
				},
				{
					"name": "2 (8px)",
					"size": "0.5rem",
					"slug": "2"
				},
				{
					"name": "3 (12px)",
					"size": "0.75rem",
					"slug": "3"
				},
				{
					"name": "4 (16px)",
					"size": "1rem",
					"slug": "4"
				},
				{
					"name": "5 (24px)",
					"size": "1.5rem",
					"slug": "5"
				},
				{
					"name": "6 (32px)",
					"size": "2rem",
					"slug": "6"
				},
				{
					"name": "7 (48px)",
					"size": "3rem",
					"slug": "7"
				},
				{
					"name": "8 (64px)",
					"size": "4rem",
					"slug": "8"
				},
				{
					"name": "9 (96px)",
					"size": "6rem",
					"slug": "9"
				},
				{
					"name": "10 (128px)",
					"size": "8rem",
					"slug": "10"
				}
			],
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vw",
				"vh"
			]
		},
		"typography": {
			"customFontSize": false,
			"fontFamilies": [
				{
					"fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"name": "System Sans",
					"slug": "sans"
				},
				{
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", monospace",
					"name": "System Mono",
					"slug": "mono"
				}
			],
			"fontSizes": [
				{
					"name": "XS",
					"size": "0.75rem",
					"slug": "xs"
				},
				{
					"name": "SM",
					"size": "0.875rem",
					"slug": "sm"
				},
				{
					"name": "SM+",
					"size": "0.9375rem",
					"slug": "sm-plus"
				},
				{
					"name": "MD",
					"size": "1rem",
					"slug": "md"
				},
				{
					"name": "MD+",
					"size": "1.0625rem",
					"slug": "md-plus"
				},
				{
					"name": "LG",
					"size": "1.125rem",
					"slug": "lg"
				},
				{
					"name": "XL",
					"size": "1.25rem",
					"slug": "xl"
				},
				{
					"name": "2XL",
					"size": "1.5rem",
					"slug": "2-xl"
				},
				{
					"name": "3XL",
					"size": "2rem",
					"slug": "3-xl"
				},
				{
					"name": "4XL",
					"size": "2.75rem",
					"slug": "4-xl"
				},
				{
					"name": "Lead",
					"size": "clamp(1.125rem, 1.6vw, 1.375rem)",
					"slug": "lead"
				},
				{
					"name": "Subtitle",
					"size": "clamp(1.375rem, 2.4vw, 1.625rem)",
					"slug": "subtitle"
				},
				{
					"name": "Title",
					"size": "clamp(1.5rem, 3vw, 2rem)",
					"slug": "title"
				},
				{
					"name": "Title LG",
					"size": "clamp(1.75rem, 4vw, 2.5rem)",
					"slug": "title-lg"
				},
				{
					"name": "Headline",
					"size": "clamp(2rem, 5vw, 3rem)",
					"slug": "headline"
				},
				{
					"name": "Display",
					"size": "clamp(2.5rem, 6vw, 4.5rem)",
					"slug": "display"
				},
				{
					"name": "Hero",
					"size": "clamp(3rem, 8vw, 5.5rem)",
					"slug": "hero"
				},
				{
					"name": "Jumbo",
					"size": "clamp(3.75rem, 12vw, 7.5rem)",
					"slug": "jumbo"
				}
			],
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": false
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"padding": {
				"left": "clamp(var(--wp--preset--spacing--5), 5vw, var(--wp--preset--spacing--6))",
				"right": "clamp(var(--wp--preset--spacing--5), 5vw, var(--wp--preset--spacing--6))"
			}
		},
		"elements": {
			"button": {
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--signal-deep)"
					}
				},
				"border": {
					"radius": "var(--wp--preset--border-radius--md)"
				},
				"color": {
					"background": "var(--wp--preset--color--ink)",
					"text": "var(--wp--preset--color--paper)"
				},
				"spacing": {
					"padding": {
						"bottom": "var(--wp--preset--spacing--3)",
						"left": "var(--wp--preset--spacing--4)",
						"right": "var(--wp--preset--spacing--4)",
						"top": "var(--wp--preset--spacing--3)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"fontWeight": "var(--wp--custom--font-weight--bold)",
					"letterSpacing": "var(--wp--custom--letter-spacing--tightest)",
					"lineHeight": "var(--wp--custom--line-height--tight)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--signal)"
				},
				"typography": {
					"textDecoration": "underline"
				}
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--lg)",
			"lineHeight": "var(--wp--custom--line-height--relaxed)"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}