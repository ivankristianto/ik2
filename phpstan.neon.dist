includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    phpVersion: 80400
    paths:
        - wp-content/themes/ik2
        - wp-content/mu-plugins
        # Composer-managed third-party plugins sit outside these paths.
        - wp-content/plugins/ik2
    scanFiles:
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-tools-stubs.php
    excludePaths:
        - wp-content/plugins/ik2/build/*
        - wp-content/themes/ik2/build/*
        # One-off WP-CLI scripts (wp eval-file), not yet typed for level 6.
        - wp-content/themes/ik2/bin/*
        - vendor/*
        - node_modules/*
