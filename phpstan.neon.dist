includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    phpVersion: 80400
    paths:
        - wp-content/themes/ik2
        - wp-content/mu-plugins
    scanFiles:
        # First-party plugin: theme blocks reference its constants & functions
        # (e.g. IK2\Plugin\PostTypes\Project\POST_TYPE). Scanning these makes
        # the symbols resolvable without expanding our analyse paths.
        - wp-content/plugins/ik2/inc/post-types/project.php
        - wp-content/plugins/ik2/inc/post-types/project-data.php
    excludePaths:
        - wp-content/plugins/*
        - wp-content/themes/ik2/build/*
        # WP-CLI maintenance scripts (wp eval-file): WP_CLI symbols are not in
        # the wordpress-stubs set this config loads.
        - wp-content/themes/ik2/bin/*
        - vendor/*
        - node_modules/*
