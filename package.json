{
	"name": "ik2org",
	"version": "0.32.1",
	"description": "ivankristianto.com — WordPress site, design system, and theme assets",
	"private": true,
	"packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start": "wp-scripts start",
		"build": "wp-scripts build",
		"format": "wp-scripts format",
		"lint": "pnpm run \"/^lint:(js|css)$/\"",
		"lint:js": "wp-scripts lint-js --no-error-on-unmatched-pattern \"wp-content/{themes/ik2,mu-plugins,plugins/ik2}/**/*.{js,jsx}\"",
		"lint:js:fix": "wp-scripts lint-js --no-error-on-unmatched-pattern \"wp-content/{themes/ik2,mu-plugins,plugins/ik2}/**/*.{js,jsx}\" --fix",
		"lint:css": "wp-scripts lint-style \"wp-content/{themes/ik2,mu-plugins,plugins/ik2}/**/*.{css,scss}\"",
		"lint:css:fix": "wp-scripts lint-style \"wp-content/{themes/ik2,mu-plugins,plugins/ik2}/**/*.{css,scss}\" --fix",
		"packages-update": "wp-scripts packages-update",
		"release": "node scripts/release.mjs",
		"tokens": "node scripts/sync-tokens.mjs",
		"tokens:check": "node scripts/sync-tokens.mjs --check",
		"test:webmcp": "node scripts/webmcp-smoke.mjs",
		"test:csp": "node scripts/csp-smoke.mjs"
	},
	"devDependencies": {
		"@wordpress/eslint-plugin": "^28.1.0",
		"@wordpress/interactivity": "^8.1.0",
		"@wordpress/prettier-config": "^5.1.0",
		"@wordpress/scripts": "^37.1.0",
		"@wordpress/stylelint-config": "^27.1.0",
		"postcss-scss": "^4.0.9",
		"prismjs": "^1.30.0",
		"sass": "^1.107.1",
		"stylelint-scss": "^7.4.0",
		"webpack-remove-empty-scripts": "^1.0.4"
	},
	"prettier": "@wordpress/prettier-config",
	"stylelint": {
		"extends": "@wordpress/stylelint-config/scss",
		"customSyntax": "postcss-scss",
		"rules": {
			"at-rule-no-unknown": [
				true,
				{
					"ignoreAtRules": [
						"use",
						"forward",
						"mixin",
						"include",
						"extend",
						"if",
						"else",
						"each",
						"for",
						"function",
						"return",
						"at-root",
						"debug",
						"warn",
						"error"
					]
				}
			],
			"selector-pseudo-class-no-unknown": [
				true,
				{
					"ignorePseudoClasses": [
						"interest-source",
						"interest-target"
					]
				}
			],
			"selector-class-pattern": [
				"^[a-z][a-z0-9-]*(__[a-z0-9-]+)?(--[a-z0-9-]+)?$",
				{
					"message": "Expected class selector to be kebab-case BEM (block, block__element, block--modifier)"
				}
			]
		}
	}
}
