<?xml version="1.0"?>
<ruleset name="ik2org">
    <description>Coding standards for ivankristianto.com</description>

    <file>wp-content/themes/ik2</file>
    <file>wp-content/mu-plugins</file>
    <file>wp-content/plugins/ik2</file>
    <file>docker/wordpress</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <!-- Third-party plugins are managed by composer (wpackagist) — never lint them.
         The first-party `ik2` plugin is included via the explicit <file> above. -->
    <exclude-pattern>*/wp-content/plugins/create-block-theme/*</exclude-pattern>
    <exclude-pattern>*/wp-content/plugins/query-monitor/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="ps"/>
    <arg name="parallel" value="8"/>

    <config name="testVersion" value="8.4-"/>
    <config name="minimum_supported_wp_version" value="6.6"/>
    <config name="text_domain" value="ik2"/>

    <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName"/>
    </rule>
    <rule ref="WordPress-Extra"/>

    <!-- Modern PHP style: require short array syntax ([]) and allow natural
         (non-Yoda) comparison order. WPCS 3 enforces long arrays via the
         Universal sniff and Yoda via the WordPress sniff, so both are disabled
         here (severity 0 survives the WordPress-Extra re-include). -->
    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
    <rule ref="Universal.Arrays.DisallowShortArraySyntax">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.PHP.YodaConditions">
        <severity>0</severity>
    </rule>

    <!--
        Homepage patterns use tax_query against indexed taxonomy tables.
        These are acceptable at site scale; suppress the generic slow-query warning.
    -->
    <rule ref="WordPress.DB.SlowDBQuery.slow_db_query_tax_query">
        <exclude-pattern>*/wp-content/themes/ik2/patterns/*</exclude-pattern>
    </rule>
</ruleset>
