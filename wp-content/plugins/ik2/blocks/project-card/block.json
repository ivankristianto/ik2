{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ik2/project-card",
	"version": "1.0.0",
	"title": "Project Card",
	"category": "theme",
	"description": "A single project card. Renders the current post inside a query loop, or a specific Project when postId is set.",
	"textdomain": "ik2",
	"supports": {
		"html": false,
		"reusable": false,
		"inserter": true,
		"align": false
	},
	"attributes": {
		"postId": {
			"type": "number",
			"default": 0
		},
		"compact": {
			"type": "boolean",
			"default": false
		}
	},
	"usesContext": [ "postId", "postType" ],
	"render": "file:./render.php"
}
