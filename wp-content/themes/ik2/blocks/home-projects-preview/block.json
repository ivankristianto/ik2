{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ik2/home-projects-preview",
	"version": "2.0.0",
	"title": "Curated Projects List",
	"category": "theme",
	"description": "Curated list of Project rows. The editor picks up to four Project IDs; with none picked, the four latest show.",
	"textdomain": "ik2",
	"supports": {
		"html": false,
		"reusable": false,
		"inserter": true,
		"multiple": false,
		"align": false
	},
	"attributes": {
		"projectIds": {
			"type": "array",
			"default": [],
			"items": { "type": "number" }
		}
	},
	"editorScript": "file:./editor.js",
	"render": "file:./render.php"
}
