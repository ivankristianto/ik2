{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ik2/now-item",
	"version": "1.0.0",
	"title": "Now Item",
	"category": "theme",
	"description": "Retired. Kept registered so stored /now entries still parse; renders nothing. Remove once no content uses it.",
	"textdomain": "ik2",
	"parent": [ "ik2/now-card" ],
	"supports": {
		"html": false,
		"reusable": false,
		"inserter": false
	},
	"attributes": {
		"label": {
			"type": "string",
			"role": "content",
			"default": ""
		},
		"text": {
			"type": "string",
			"role": "content",
			"default": ""
		}
	},
	"editorScript": "file:./editor.js",
	"render": "file:./render.php"
}
