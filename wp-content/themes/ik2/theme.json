{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#F8F7F3",
					"name": "Paper",
					"slug": "paper"
				},
				{
					"color": "#FFFFFF",
					"name": "Surface",
					"slug": "surface"
				},
				{
					"color": "#F1EFE8",
					"name": "Soft Paper",
					"slug": "soft-paper"
				},
				{
					"color": "#171717",
					"name": "Ink",
					"slug": "ink"
				},
				{
					"color": "#5F6368",
					"name": "Graphite",
					"slug": "graphite"
				},
				{
					"color": "#8A8F98",
					"name": "Dust",
					"slug": "dust"
				},
				{
					"color": "#D8D5CC",
					"name": "Line",
					"slug": "line"
				},
				{
					"color": "#B9B5AA",
					"name": "Rule",
					"slug": "rule"
				},
				{
					"color": "#C2410C",
					"name": "Terracotta",
					"slug": "signal"
				},
				{
					"color": "#9A3412",
					"name": "Deep Terracotta",
					"slug": "signal-deep"
				},
				{
					"color": "#FFEDD5",
					"name": "Terracotta Soft",
					"slug": "signal-soft"
				},
				{
					"color": "#EFEEE8",
					"name": "Code Paper",
					"slug": "code-paper"
				},
				{
					"color": "#111827",
					"name": "Code Ink",
					"slug": "code-ink"
				},
				{
					"color": "#15803D",
					"name": "Build Green",
					"slug": "build-green"
				},
				{
					"color": "#B45309",
					"name": "Amber",
					"slug": "amber"
				},
				{
					"color": "#B91C1C",
					"name": "Red",
					"slug": "red"
				}
			]
		},
		"custom": {
			"width": {
				"full": "1280px"
			}
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1080px"
		},
		"spacing": {
			"spacingSizes": [
				{
					"name": "1 — 4px",
					"size": "0.25rem",
					"slug": "1"
				},
				{
					"name": "2 — 8px",
					"size": "0.5rem",
					"slug": "2"
				},
				{
					"name": "3 — 12px",
					"size": "0.75rem",
					"slug": "3"
				},
				{
					"name": "4 — 16px",
					"size": "1rem",
					"slug": "4"
				},
				{
					"name": "5 — 24px",
					"size": "1.5rem",
					"slug": "5"
				},
				{
					"name": "6 — 32px",
					"size": "2rem",
					"slug": "6"
				},
				{
					"name": "7 — 48px",
					"size": "3rem",
					"slug": "7"
				},
				{
					"name": "8 — 64px",
					"size": "4rem",
					"slug": "8"
				},
				{
					"name": "9 — 96px",
					"size": "6rem",
					"slug": "9"
				},
				{
					"name": "10 — 128px",
					"size": "8rem",
					"slug": "10"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"fontFamilies": [
				{
					"fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"name": "System Sans",
					"slug": "sans"
				},
				{
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", monospace",
					"name": "System Mono",
					"slug": "mono"
				}
			],
			"fontSizes": [
				{
					"name": "XS",
					"size": "0.75rem",
					"slug": "xs"
				},
				{
					"name": "SM",
					"size": "0.875rem",
					"slug": "sm"
				},
				{
					"name": "MD",
					"size": "1rem",
					"slug": "md"
				},
				{
					"name": "LG",
					"size": "1.125rem",
					"slug": "lg"
				},
				{
					"name": "XL",
					"size": "1.25rem",
					"slug": "xl"
				},
				{
					"name": "2XL",
					"size": "1.5rem",
					"slug": "2-xl"
				},
				{
					"name": "3XL",
					"size": "2rem",
					"slug": "3-xl"
				},
				{
					"name": "4XL",
					"size": "2.75rem",
					"slug": "4-xl"
				},
				{
					"name": "Hero",
					"size": "clamp(3rem, 8vw, 5.5rem)",
					"slug": "hero"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"padding": {
				"left": "clamp(1.5rem, 5vw, 2rem)",
				"right": "clamp(1.5rem, 5vw, 2rem)"
			}
		},
		"elements": {
			"button": {
				"border": {
					"radius": "0.375rem"
				},
				"spacing": {
					"padding": {
						"bottom": "0.75rem",
						"left": "1rem",
						"right": "1rem",
						"top": "0.75rem"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"fontWeight": "700",
					"letterSpacing": "-0.04em",
					"lineHeight": "1.1"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--signal)"
				},
				"typography": {
					"textDecoration": "underline"
				}
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--lg)",
			"lineHeight": "1.7"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}