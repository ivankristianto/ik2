{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "paper",        "name": "Paper",       "color": "#F8F7F3" },
        { "slug": "surface",      "name": "Surface",     "color": "#FFFFFF" },
        { "slug": "soft-paper",   "name": "Soft Paper",  "color": "#F1EFE8" },
        { "slug": "ink",          "name": "Ink",         "color": "#171717" },
        { "slug": "graphite",     "name": "Graphite",    "color": "#5F6368" },
        { "slug": "dust",         "name": "Dust",        "color": "#8A8F98" },
        { "slug": "line",         "name": "Line",        "color": "#D8D5CC" },
        { "slug": "rule",         "name": "Rule",        "color": "#B9B5AA" },
        { "slug": "signal",       "name": "Signal Blue", "color": "#2563EB" },
        { "slug": "signal-deep",  "name": "Deep Signal", "color": "#1D4ED8" },
        { "slug": "signal-soft",  "name": "Signal Soft", "color": "#DBEAFE" },
        { "slug": "code-paper",   "name": "Code Paper",  "color": "#EFEEE8" },
        { "slug": "code-ink",     "name": "Code Ink",    "color": "#111827" },
        { "slug": "build-green",  "name": "Build Green", "color": "#15803D" },
        { "slug": "amber",        "name": "Amber",       "color": "#B45309" },
        { "slug": "red",          "name": "Red",         "color": "#B91C1C" }
      ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1080px"
    },
    "spacing": {
      "spacingSizes": [
        { "slug": "1", "name": "1 — 4px",   "size": "0.25rem" },
        { "slug": "2", "name": "2 — 8px",   "size": "0.5rem"  },
        { "slug": "3", "name": "3 — 12px",  "size": "0.75rem" },
        { "slug": "4", "name": "4 — 16px",  "size": "1rem"    },
        { "slug": "5", "name": "5 — 24px",  "size": "1.5rem"  },
        { "slug": "6", "name": "6 — 32px",  "size": "2rem"    },
        { "slug": "7", "name": "7 — 48px",  "size": "3rem"    },
        { "slug": "8", "name": "8 — 64px",  "size": "4rem"    },
        { "slug": "9", "name": "9 — 96px",  "size": "6rem"    },
        { "slug": "10","name": "10 — 128px","size": "8rem"    }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "System Sans",
          "fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        },
        {
          "slug": "mono",
          "name": "System Mono",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", monospace"
        }
      ],
      "fontSizes": [
        { "slug": "xs",   "name": "XS",   "size": "0.75rem"  },
        { "slug": "sm",   "name": "SM",   "size": "0.875rem" },
        { "slug": "md",   "name": "MD",   "size": "1rem"     },
        { "slug": "lg",   "name": "LG",   "size": "1.125rem" },
        { "slug": "xl",   "name": "XL",   "size": "1.25rem"  },
        { "slug": "2-xl", "name": "2XL",  "size": "1.5rem"   },
        { "slug": "3-xl", "name": "3XL",  "size": "2rem"     },
        { "slug": "4-xl", "name": "4XL",  "size": "2.75rem"  },
        { "slug": "hero", "name": "Hero", "size": "clamp(3rem, 8vw, 5.5rem)" }
      ]
    },
    "custom": {
      "width": {
        "full": "1280px"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|lg",
      "lineHeight": "1.7"
    },
    "elements": {
      "link": {
        "color":      { "text": "var:preset|color|signal" },
        "typography": { "textDecoration": "underline" }
      },
      "heading": {
        "color":      { "text": "var:preset|color|ink" },
        "typography": { "fontWeight": "700", "lineHeight": "1.1", "letterSpacing": "-0.04em" }
      },
      "button": {
        "border": { "radius": "0.375rem" },
        "spacing": { "padding": { "top": "0.75rem", "right": "1rem", "bottom": "0.75rem", "left": "1rem" } }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
